# ============================================
# Ledgix AI Frontend - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values

# ── Backend URLs ─────────────────────────────────────────────────────────────────
# Public URL used in browser for API calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Internal URL used server-side (e.g., for media proxy)
# In Docker, use the service name: http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# ── NextAuth Configuration ──────────────────────────────────────────────────────────
# Public-facing URL for NextAuth callbacks
NEXTAUTH_URL=http://localhost:3000
# Internal URL (omit in production, same as NEXTAUTH_URL locally)
NEXTAUTH_URL_INTERNAL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# ── Google OAuth - Sign-In ────────────────────────────────────────────────────────
# Create OAuth client at https://console.cloud.google.com/
# These are for NextAuth authentication (separate from Gmail integration on backend)
GOOGLE_CLIENT_ID_AUTH=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_AUTH=your-client-secret

# ── WebSocket Configuration ────────────────────────────────────────────────────────
# WebSocket URL for real-time invoice updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Enable/disable WebSocket connection
NEXT_PUBLIC_ENABLE_WS=true

# ── Stripe - Billing ───────────────────────────────────────────────────────────────
# Publishable key (must match backend DEV_STRIPE_PUBLISHABLE_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── Demo Account (Optional) ───────────────────────────────────────────────────────
# Pre-filled credentials for demo mode
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
